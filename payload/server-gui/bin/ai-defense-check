#!/opt/server-gui/venv/bin/python
"""payload/server-gui/bin/ai-defense-check - Run the periodic Jev AI defense check.

The systemd timer invokes this entrypoint hourly.  The module itself decides
whether the configured interval is due, and stdout deliberately contains only
aggregate counters so journald never receives API keys, IP addresses, or logs.
"""
from __future__ import annotations

import json
import os
import sys
from pathlib import Path


def _summary(result: dict) -> dict:
    """Return the timer-safe subset of a result for journald output."""
    return {
        "ok": bool(result.get("ok")),
        "status": str(result.get("status") or "unknown"),
        "candidate_count": int(result.get("candidate_count") or 0),
        "blocked_count": int(result.get("blocked_count") or 0),
    }


def main() -> int:
    """Load the shared module, run one check, and preserve its fail-open result."""
    config_dir = Path(os.environ.get("SERVER_GUI_CONFIG_DIR", "/etc/server-gui"))
    sys.path.insert(0, "/opt/server-gui")
    try:
        from server_gui.modules.ai_defense import DefenseBusy, run_scheduled_check
    except ImportError:
        print(json.dumps({"ok": False, "status": "import_failed"}), file=sys.stderr)
        return 1
    try:
        result = run_scheduled_check(config_dir)
    except DefenseBusy:
        print(json.dumps({"ok": True, "status": "already_running"}))
        return 0
    except Exception:
        print(json.dumps({"ok": False, "status": "unexpected_error"}), file=sys.stderr)
        return 1
    print(json.dumps(_summary(result), sort_keys=True))
    return 0 if result.get("ok") else 1


if __name__ == "__main__":
    sys.exit(main())
