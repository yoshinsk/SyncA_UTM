# Auto detect text files and perform LF normalization
* text=auto
.gitattributes text eol=lf

# Installer and helper scripts are executed on Linux build/install hosts.
*.sh text eol=lf
*.ks text eol=lf
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.conf text eol=lf
iso/payload/* text eol=lf
iso/kickstart/* text eol=lf
scripts/* text eol=lf
